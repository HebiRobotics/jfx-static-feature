<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Everything an example shares: Central's JavaFX, the feature, and a native-maven-plugin setup
      with nothing in it beyond what any native-image project writes. An example adds its image
      name and main class.
    -->
    <groupId>us.hebi.graalvm</groupId>
    <artifactId>jfx-static-examples</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>jfx-static-examples</name>
    <description>Example applications built as static JavaFX native images</description>

    <modules>
        <module>hellofx</module>
        <module>headless</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>26</javafx.version>
        <jfx.static.feature.version>1.0-SNAPSHOT</jfx.static.feature.version>
        <!-- The profile below is inherited, and this pom has no main class to build an image of -->
        <skipNativeBuild>true</skipNativeBuild>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>us.hebi.graalvm</groupId>
            <artifactId>jfx-static-feature</artifactId>
            <version>${jfx.static.feature.version}</version>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <!-- 1.x is the line that ships the GraalVM 25 metadata format -->
                    <version>1.0.0</version>
                    <executions>
                        <execution>
                            <id>build-native</id>
                            <phase>package</phase>
                            <goals>
                                <goal>compile-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <fallback>false</fallback>
                        <!-- The feature jar and the FX metadata it depends on are the whole configuration -->
                        <metadataRepository>
                            <enabled>false</enabled>
                        </metadataRepository>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
